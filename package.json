{
  "name": "dsh-vision",
  "description": "Workspace root: the @ran-sh/dsh-vision service package (owns ctx.vision) plus the dsh-plugin-image-mind provider/tool plugin (injects ['vision'] and registers into it), following the DeepSeek Harness Service Definition / Provider Plugin split.",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vision",
    "packages/image-mind"
  ],
  "scripts": {
    "typecheck": "npm --workspaces run typecheck",
    "test": "npm --workspaces run test && vitest run --config vitest.config.ts",
    "build": "npm --workspaces run build",
    "test:e2e": "node scripts/run-e2e.mjs",
    "diagnose:dsh": "node scripts/diagnose-dsh.mjs",
    "test:package": "vitest run --config vitest.config.ts tests/package.test.ts",
    "test:built": "vitest run --config vitest.config.ts tests/built.test.ts",
    "benchmark:run": "node scripts/run-vision-benchmark.mjs",
    "benchmark:deterministic": "node scripts/run-deterministic-vision-benchmark.mjs",
    "benchmark:corpus": "node scripts/generate-vision-benchmark-corpus.mjs",
    "benchmark:preprocess": "node scripts/compare-long-image-preprocess.mjs",
    "benchmark:score": "node scripts/vision-benchmark-score.mjs",
    "benchmark:compare": "node scripts/vision-benchmark-compare.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.17",
    "@deepseek-ai/cordis-plugin-include": "1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh": "0.1.2-alpha.5",
    "@deepseek-ai/cosmokit": "1.8.3",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/node-addon-landlock-run": "0.1.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/react": "~18.3.12",
    "esbuild": "^0.25.5",
    "react": "18.2.0",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "koffi@3.1.6": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.5": true,
    "@deepseek-ai/dsh-subprocess-local@0.1.1-rc.2": true,
    "@google/genai@1.52.0": true
  }
}