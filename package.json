{
  "name": "dsh-vision",
  "description": "Workspace root: the @ran-sh/dsh-vision service package (owns ctx.vision) plus the dsh-plugin-image-mind provider/tool plugin (injects ['vision'] and registers into it), following the DeepSeek Harness Service Definition / Provider Plugin split.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vision",
    "packages/image-mind"
  ],
  "scripts": {
    "typecheck": "npm -ws run typecheck",
    "test": "npm -ws run test && vitest run --config vitest.config.ts",
    "build": "npm -ws run build",
    "install:dsh": "node scripts/install-dsh.mjs",
    "uninstall:dsh": "node scripts/uninstall-dsh.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/cosmokit": "1.8.2",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/node-addon-landlock-run": "0.1.1",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9"
  }
}
