{
  "name": "dsh-plugin-image-mind",
  "description": "Image-understanding provider plugin for the DeepSeek Harness (DSH) web UI: injects ['vision'] and registers the OpenAI-compatible vision adapter, the provider directory, and the understand_image tool into ctx.vision (owned by @ran-sh/dsh-vision). The tool lets a text-only model ask an OpenAI-compatible vision endpoint (Qwen-VL, GLM-4V, GPT-4o, local Ollama...) about one or more images; only the returned text enters the conversation.",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "link-sdk": "node scripts/devhelpers/link-sdk.mjs",
    "unlink-sdk": "node scripts/devhelpers/link-sdk.mjs --remove",
    "dev:verify": "node --no-warnings scripts/e2e-vision.ts",
    "dev:retry": "node --no-warnings scripts/e2e-retry.ts",
    "dev:test-connect": "node --no-warnings scripts/e2e-test-connect.ts"
  },
  "dependencies": {
    "@ran-sh/dsh-vision": "file:../vision",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/cordis": "4.0.1",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
